{
  "manifest_version": 1,
  "type": "device",
  "name": "Android TV Remote",
  "description": {
    "en": "Gladys Assistant integration for Android TV and Google TV using Remote v2 protocol.",
    "fr": "Intégration Gladys Assistant pour Android TV et Google TV via le protocole Remote v2."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-integration-android-tv-remote:1.0.0",
  "gladys_version": ">=4.62.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-integration-android-tv-remote/main/cover.png",
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Android TV / Google TV Connection", "fr": "Connexion Android TV / Google TV" },
      "description": {
        "en": "Configure your Android TV devices. You can connect and pair multiple TVs on your local network.",
        "fr": "Configurez vos appareils Android TV. Vous pouvez connecter et appairer plusieurs TV sur votre réseau local."
      }
    },
    {
      "key": "tvs",
      "type": "array",
      "label": { "en": "Android TV Devices", "fr": "Appareils Android TV" },
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "label": { "en": "TV Name", "fr": "Nom de la TV" },
            "default": "Living Room TV"
          },
          "ip": {
            "type": "string",
            "label": { "en": "TV IP Address", "fr": "Adresse IP de la TV" },
            "required": true,
            "default": "192.168.1.50"
          },
          "certificate_key": {
            "type": "secret",
            "label": { "en": "Client Private Key", "fr": "Clé privée client" },
            "required": false
          },
          "certificate_cert": {
            "type": "secret",
            "label": { "en": "Client Certificate", "fr": "Certificat client" },
            "required": false
          }
        }
      }
    },
    {
      "key": "enable_app_shortcuts",
      "type": "boolean",
      "label": { "en": "Enable App Shortcuts", "fr": "Activer les raccourcis d'applications" },
      "description": {
        "en": "Create individual features to launch apps (Netflix, YouTube, Prime Video, Disney+, Spotify, Plex, Arte).",
        "fr": "Créer des fonctionnalités dédiées pour lancer des applications (Netflix, YouTube, Prime Video, Disney+, Spotify, Plex, Arte)."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "start_pairing",
      "label": {
        "en": "1. Start Pairing (Show PIN on target TV)",
        "fr": "1. Démarrer l'appairage (Afficher le PIN sur la TV ciblée)"
      },
      "timeout_seconds": 30
    },
    {
      "key": "submit_pin",
      "label": { "en": "2. Confirm PIN Code", "fr": "2. Valider le code PIN" },
      "timeout_seconds": 30
    },
    {
      "key": "test_connection",
      "label": { "en": "Test TV Connection", "fr": "Tester la connexion TV" },
      "timeout_seconds": 30
    }
  ]
}
